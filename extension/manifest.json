{
  "manifest_version": 3,
  "name": "Urge Zero — A pause can change everything",
  "version": "1.0.0",
  "description": "Interrupt mindless digital loops with intentional pauses, website restrictions, and Focus Breach Alarms.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Urge Zero",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "intervention.html",
        "popup.html",
        "icons/*",
        "logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
